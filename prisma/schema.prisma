generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  USER
  STAFF
  ADMIN
}

enum StaffRole {
  GENERAL_OFFICER
  SENIOR_VISA_OFFICER
  MEDICAL_TOURISM_DESK
  ACADEMIC_COUNSELOR
  CV_DOCUMENT_SPECIALIST
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  DOCUMENT_VERIFIED
  HOSPITAL_ACCEPTED
  EMPLOYER_VETTED
  ADMISSION_OFFERED
  VISA_PROCESSING
  APPROVED_READY
  REJECTED
  ACTION_REQUIRED
}

enum PaymentStatus {
  UNPAID
  REGISTRATION_PAID
  BALANCE_PENDING
  FULLY_PAID
  DIRECT_HOSPITAL_BILL
}

// ----------------------------------------------------
// USER & AUTHENTICATION MODEL
// ----------------------------------------------------

model User {
  id                      String                  @id @default(cuid())
  fullName                String
  email                   String                  @unique
  phone                   String
  password                String
  ninNumber               String?
  passportNumber          String?
  role                    Role                    @default(USER)
  staffRole               StaffRole?
  isSuspended             Boolean                 @default(false)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  medicalCases            MedicalCase[]
  jobApplications         JobApplication[]
  scholarships            ScholarshipApplication[]
  visaRequests            VisaRequest[]
  flightBookings          FlightBooking[]
  uploadedDocuments       Document[]
  sentMessages            Message[]
}

// ----------------------------------------------------
// 1. MEDICAL TOURISM MODEL
// ----------------------------------------------------

model MedicalCase {
  id                      String            @id @default(cuid())
  refId                   String            @unique
  userId                  String?
  user                    User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  patientName             String
  age                     Int
  gender                  String
  passportNumber          String
  companionName           String?
  companionPassport       String?

  treatmentCategory       String
  medicalCondition        String
  hospitalPreference      String?
  countryOfTreatment      String            @default("India")
  medicalReportsUrl       String
  passportUrl             String?

  registrationFee         Float             @default(50000.0)
  paymentStatus           PaymentStatus     @default(UNPAID)
  paymentRef              String?
  estimatedHospitalCost   String?
  status                  ApplicationStatus @default(SUBMITTED)

  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

// ----------------------------------------------------
// 2. WORK ABROAD & JOB APPLICANTS MODEL
// ----------------------------------------------------

model JobApplication {
  id                      String            @id @default(cuid())
  refId                   String            @unique
  userId                  String?
  user                    User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  applicantName           String
  passportNumber          String
  phone                   String
  targetCountry           String
  jobCategory             String
  yearsExperience         Int               @default(1)

  originalCvUrl           String
  formattedCvUrl          String?
  tradeCertificateUrl     String?
  passportUrl             String?

  paymentStatus           PaymentStatus     @default(UNPAID)
  paymentRef              String?
  successBalanceAmount    Float             @default(200000.0)
  status                  ApplicationStatus @default(SUBMITTED)

  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

// ----------------------------------------------------
// 3. SCHOLARSHIP & STUDY ABROAD MODEL
// ----------------------------------------------------

model ScholarshipApplication {
  id                      String            @id @default(cuid())
  refId                   String            @unique
  userId                  String?
  user                    User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  studentName             String
  passportNumber          String
  phone                   String
  targetCountry           String
  targetUniversity        String?
  degreeLevel             String
  intendedCourse          String

  waecOrOLevelUrl         String
  transcriptUrl           String?
  academicCvUrl           String?
  passportUrl             String?

  tuitionWaiverGranted    String?
  paymentStatus           PaymentStatus     @default(UNPAID)
  paymentRef              String?
  status                  ApplicationStatus @default(SUBMITTED)

  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

// ----------------------------------------------------
// 4. VISA REQUESTS & UMRAH MODEL
// ----------------------------------------------------

model VisaRequest {
  id                      String            @id @default(cuid())
  refId                   String            @unique
  userId                  String?
  user                    User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  leadApplicantName       String
  passportNumber          String
  contactPhone            String
  visaType                String
  destinationCountry      String
  pilgrimsOrTravelersCount Int              @default(1)
  travelMonthOrSeason     String?
  hotelPackageChosen      String?

  combinedPassportsUrl    String?
  invitationOrBrnNumber   String?

  paymentStatus           PaymentStatus     @default(UNPAID)
  paymentRef              String?
  status                  ApplicationStatus @default(SUBMITTED)

  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

// ----------------------------------------------------
// 5. FLIGHT BOOKING & GDS RESERVATIONS MODEL
// ----------------------------------------------------

model FlightBooking {
  id                      String            @id @default(cuid())
  refId                   String            @unique
  userId                  String?
  user                    User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  leadPassengerName       String
  primaryPassportNumber   String
  tripType                String
  departureAirport        String
  arrivalAirport          String
  departureDate           DateTime
  returnDate              DateTime?
  passengersCount         Int               @default(1)
  cabinClass              String            @default("Economy")
  preferredAirline        String?
  gdsPnrCode              String?

  paymentStatus           PaymentStatus     @default(UNPAID)
  status                  ApplicationStatus @default(SUBMITTED)

  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

// ----------------------------------------------------
// 6. GENERAL DOCUMENTS VAULT
// ----------------------------------------------------

model Document {
  id                      String            @id @default(cuid())
  userId                  String
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                   String
  fileUrl                 String
  fileSize                String?
  fileCategory            String
  createdAt               DateTime          @default(now())
}

// ----------------------------------------------------
// 7. DIRECT MESSAGES & AUDIT NOTIFICATIONS
// ----------------------------------------------------

model Message {
  id                      String            @id @default(cuid())
  userId                  String
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderRole              String
  senderName              String
  subject                 String
  body                    String
  isRead                  Boolean           @default(false)
  createdAt               DateTime          @default(now())
}